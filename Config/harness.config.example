# AntigravityCLI-Harness standard configuration template (tracked in Git).
# Copy this file to Config/harness.config (gitignored) to store machine-specific paths.
# Supported placeholders: ${REPO_ROOT}, ${USERPROFILE}

[paths]
repo_root = ${REPO_ROOT}
scripts_dir = ${REPO_ROOT}/scripts
logs_dir = ${REPO_ROOT}/logs
tmp_dir = ${REPO_ROOT}/tmp

[antigravity]
app_data_dir = ${USERPROFILE}/.gemini/antigravity-cli
brain_dir = ${USERPROFILE}/.gemini/antigravity-cli/brain
cli_log_dir = ${USERPROFILE}/.gemini/antigravity-cli/log
annotations_dir = ${USERPROFILE}/.gemini/antigravity-cli/annotations
conversation_cache_file = ${USERPROFILE}/.gemini/antigravity-cli/cache/conversation_metadata.json

[executables]
# Leave blank to auto-detect from PATH or standard install locations.
# Examples in your local Config/harness.config:
# agy_exe = D:/Tools/AntigravityCLI/bin/agy.exe
# python_exe = C:/Python311/python.exe
# browser_exe = C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# wt_exe = ${USERPROFILE}/AppData/Local/Microsoft/WindowsApps/wt.exe
agy_exe =
python_exe =
browser_exe =
wt_exe =

[watchdog]
script = ${REPO_ROOT}/scripts/watchdog/agy-watchdog.ps1
out_log = ${REPO_ROOT}/logs/agy_watchdog.log
pid_file = ${REPO_ROOT}/logs/watchdog.pid
eof_signal_file = ${REPO_ROOT}/tmp/eof_signal.json

[hooks]
check_context_script = ${REPO_ROOT}/scripts/hooks/check-context.py
auto_compact_hook_script = ${REPO_ROOT}/scripts/hooks/auto-compact-hook.py
state_file = ${REPO_ROOT}/logs/hook_state.json
trace_log = ${REPO_ROOT}/logs/hook_trace.log

[compact]
request_script = ${REPO_ROOT}/scripts/compact/request-compact.ps1
worker_script = ${REPO_ROOT}/scripts/compact/auto-compact-worker.ps1
injector_script = ${REPO_ROOT}/scripts/injector/send-console-input.ps1
request_file = ${REPO_ROOT}/tmp/compact_request.json
out_log = ${REPO_ROOT}/logs/auto_compact.log
state_file = ${REPO_ROOT}/logs/auto_compact_state.json

[sidebar]
launcher_script = ${REPO_ROOT}/scripts/sidebar/launch-sidebar.ps1
server_script = ${REPO_ROOT}/scripts/sidebar/sidebar_server.py
web_dir = ${REPO_ROOT}/scripts/sidebar/web
vendor_dir = ${REPO_ROOT}/scripts/sidebar/vendor
state_file = ${REPO_ROOT}/tmp/sidebar_state.json
dock_registry_dir = ${REPO_ROOT}/tmp/sidebar_docks
edge_profile_dir = ${REPO_ROOT}/tmp/edge-sidebar-profile
width_ratio = 0.38
